{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=StoreDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Jwt": {
    "Issuer": "Store.Api",
    "Audience": "Store.Client",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Orders": {
    "PendingTimeoutMinutes": 30,
    "CleanupIntervalSeconds": 60
  },
  "RateLimiting": {
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Seed": {
    "Enabled": false
  },
  "BackgroundJobs": {
    "Enabled": true
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:4173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
