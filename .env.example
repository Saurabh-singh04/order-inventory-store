MSSQL_SA_PASSWORD=ChangeMe_Str0ng!

# JWT signing key - any random string of at least 32 characters
JWT_KEY=replace-with-a-long-random-string-of-32-plus-chars

# Passwords given to the seeded demo accounts
SEED_ADMIN_PASSWORD=Admin@123
SEED_CUSTOMER_PASSWORD=Customer@123
